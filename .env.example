SECRET_KEY=replace-with-a-strong-secret
UPLOAD_FOLDER=uploads
GEMINI_MODEL=gemini-1.5-flash
GEMINI_CONFIG_PATH=uploads/Admin/config.txt
PLANNER_DATA_FILE=planner.json
APP_TIMEZONE=Asia/Singapore
ICS_CALENDAR_CONFIG_PATH=uploads/Admin/ics_calendar.json
ICS_CALENDAR_CACHE_FILE=uploads/Admin/ics_calendar_cache.json
MAX_CONTENT_LENGTH=5368709120
USER_DATA_FILE=users.json
FEEDBACK_FILE=feedback.json
SERVER_LOG_FILE=server.log
DATA_TRANSFER_LOG=data_transfer.log
# GOOGLE_API_KEY=your-google-api-key

# Private MacroDroid aircon controller settings file.
AC_CONTROL_FILE=ac_control.json

# Separate password for the private /aircon controller portal.
AIRCON_PORTAL_PASSWORD=replace-with-a-separate-aircon-password
AIRCON_SESSION_HOURS=24

# Persistent aircon usage and cost totals.
AC_STATISTICS_FILE=ac_statistics.json

# Optional HTTPS configuration.
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
