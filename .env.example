# Core
SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Singapore

# Aircon portal
AIRCON_PORTAL_PASSWORD=replace-with-a-private-password
AIRCON_SESSION_HOURS=24
AC_CONTROL_FILE=ac_control.json
AC_STATISTICS_FILE=ac_statistics.json
AC_HISTORY_FILE=ac_history.json
AC_WEEKLY_FILE=ac_weekly.json
AC_RUNTIME_FILE=ac_runtime.json
AIRCON_RATE_PER_HOUR=0.39

# Open http://localhost:5000/server on the phone and allow camera access.
# Keep that page open while watching Admin -> Live video remotely.
CAMERA_OPEN_WEBHOOK_URL=http://127.0.0.1:8080/web
CAMERA_OPEN_WEBHOOK_TIMEOUT_SECONDS=5
# Inworld remote voice. Keep the real key only in .env, never in source control.
INWORLD_API_KEY=replace-with-your-inworld-basic-key
TTS_API_URL=https://api.inworld.ai/tts/v1/voice
TTS_VOICE_ID=Sarah
TTS_MODEL_ID=inworld-tts-2
TTS_SPEAKING_RATE=1.0
TTS_DELIVERY_MODE=BALANCED
TTS_LANGUAGE=AUTO
TTS_MAX_CHARS=1000
TTS_API_TIMEOUT_SECONDS=20
