SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Singapore

UPLOAD_FOLDER=/srv/tamestorage/uploads
MAX_CONTENT_LENGTH=5368709120
USER_DATA_FILE=/srv/tamestorage/.tamestorage_state/users.json
SHARE_DATA_FILE=/srv/tamestorage/.tamestorage_state/shares.json
SHARE_AUDIT_FILE=/srv/tamestorage/.tamestorage_state/share_audit.json
ACTIVITY_FILE=/srv/tamestorage/.tamestorage_state/activity_log.json
TRASH_FILE=/srv/tamestorage/.tamestorage_state/trash_index.json
VERSIONS_FILE=/srv/tamestorage/.tamestorage_state/versions.json
METADATA_FILE=/srv/tamestorage/.tamestorage_state/file_metadata.json
NOTIFICATIONS_FILE=/srv/tamestorage/.tamestorage_state/notifications.json
FILE_REQUESTS_FILE=/srv/tamestorage/.tamestorage_state/file_requests.json
SERVER_LOG_FILE=/srv/tamestorage/.tamestorage_state/server.log
DATA_TRANSFER_LOG=/srv/tamestorage/.tamestorage_state/data_transfer.log
DEFAULT_USER_QUOTA_BYTES=0

MUSIC_FOLDER=/srv/music
PLAYLISTS_FILE=/srv/tamestorage/.tamestorage_state/playlists.json
PLAYLIST_LOG_DIR=/srv/tamestorage/.tamestorage_state/playlist_logs
PLAYLIST_RUNTIME_DIR=/srv/tamestorage/.tamestorage_state/playlist_runtime
PLAYLIST_WORKER_POLL_SECONDS=10
PLAYLIST_DELETE_CONFIRM_SECONDS=300
PLAYLIST_SNAPSHOT_TIMEOUT_SECONDS=900
