#!/usr/bin/env bash
set -euo pipefail

source_mount=/srv/tamestorage
backup_mount=/srv/tamestorage-backup
source_uuid=1e5557c2-1302-4632-9937-3e2db211c295
backup_uuid=70e5d00b-c0e1-4bdd-84cc-1af5e56c75f8

exec 9>/run/tamestorage-backup.lock
flock -n 9 || exit 0

if ! mountpoint -q "$source_mount" || ! mountpoint -q "$backup_mount"; then
    echo "Both Tamestorage disks must be mounted; refusing to run." >&2
    exit 1
fi

if [[ "$(findmnt -n -o UUID --target "$source_mount")" != "$source_uuid" ]]; then
    echo "Primary disk UUID mismatch; refusing to run." >&2
    exit 1
fi

if [[ "$(findmnt -n -o UUID --target "$backup_mount")" != "$backup_uuid" ]]; then
    echo "Backup disk UUID mismatch; refusing to run." >&2
    exit 1
fi

ionice -c 2 -n 7 nice -n 19 rsync \
    -aHAX --numeric-ids --delete-before --inplace \
    --exclude=/lost+found/ \
    --exclude=/.nas-last-success \
    "$source_mount/" "$backup_mount/"

date --iso-8601=seconds > "$backup_mount/.nas-last-success"
sync -f "$backup_mount/.nas-last-success"
