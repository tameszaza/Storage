#!/usr/bin/env bash
set -euo pipefail

[[ ! -f /etc/tamestorage-operations.conf ]] || source /etc/tamestorage-operations.conf
backup_days=${BACKUP_RETENTION_DAYS:-30}

source_mount=/srv/tamestorage
backup_mount=/srv/tamestorage-backup
stamp=$(date -u +%Y%m%dT%H%M%SZ)
version_rel=.backup-versions/$stamp

exec 9>/run/lock/tamestorage-backup.lock
flock -n 9 || exit 0

mountpoint -q "$source_mount" || { echo "primary is not mounted" >&2; exit 1; }
/usr/local/sbin/tamestorage-temp-cleanup
mountpoint -q "$backup_mount" || { echo "backup is not mounted" >&2; exit 1; }
[[ $(findmnt -n -o FSTYPE -T "$source_mount") == ext4 ]] || exit 1
[[ $(findmnt -n -o FSTYPE -T "$backup_mount") == ext4 ]] || exit 1

install -d -m 0700 "$backup_mount/.backup-versions/$stamp"
rsync -aHAX --numeric-ids \
    --delete-delay \
    --backup \
    --backup-dir="$version_rel" \
    --exclude='/.backup-versions/' \
    --exclude='/.nas-last-success' \
    --exclude='/uploads/Admin/Movies/' \
    --exclude='/uploads/temp/' \
    "$source_mount/" "$backup_mount/"

find "$backup_mount/.backup-versions" -mindepth 1 -maxdepth 1 -type d -mtime +"$backup_days" -exec rm -rf -- {} +
printf '%s\n' "$stamp" > "$backup_mount/.nas-last-success"
