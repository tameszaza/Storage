[Unit]
Description=Goodnotes event-triggered Obsidian PDF link catalog
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=tameszaza
Group=tameszaza
Environment=HOME=/home/tameszaza
WorkingDirectory=/home/tameszaza/.local/lib/goodnotes-links
ExecStart=/usr/bin/python3 /home/tameszaza/.local/lib/goodnotes-links/watch.py
Restart=on-failure
RestartSec=60
Nice=10
IOSchedulingClass=idle
MemoryMax=384M
CPUQuota=25%
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
