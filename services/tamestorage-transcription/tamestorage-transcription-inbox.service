[Unit]
Description=Import completed recordings into the Cyborg transcription queue
ConditionPathIsMountPoint=/srv/tamestorage

[Service]
Type=oneshot
User=tameszaza
Group=tameszaza
ExecStart=/usr/bin/python3 -B /home/tameszaza/.local/lib/tamestorage-transcription/inbox.py
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=128M
MemorySwapMax=0
TasksMax=8
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/tamestorage/.tamestorage_state/transcription /srv/tamestorage/uploads/temp/Transcription
UMask=0077
